# Inspirations retained: Kvantum Theme-Config translucency keys, Nordic-style
# dark transparent variants, and Utterly-Sweet transparent Plasma theming.

[General]
author=Dimension OS
comment=Dimension Glass dark glassmorphism theme
inherits=Breeze
color_scheme_path=Dimension.colors
widgetless_scrollbars=true
scrollbar_in_view=true
transient_scrollbar=true
menu_shadow_depth=6
tooltip_shadow_depth=4
shadowless_popup=false
composite=true
translucent_windows=true
translucency=true
blurring=true
popup_blurring=true
window_opacity=85
reduce_window_opacity=10
reduce_menu_opacity=20
reduce_tooltip_opacity=18
noninteger_translucency=false
contrast=0.86
intensity=1.04
saturation=1.08
roundness=8
animation=true

[Colors]
window.color=#000F1F
base.color=#071523
alt.base.color=#0E1825
button.color=#12263A
light.color=#193552
mid.light.color=#10283E
mid.color=#0A1C2E
dark.color=#000914
shadow.color=#00070F
highlight.color=#0078D7
inactive.highlight.color=#285F8F
text.color=#E8F0F8
window.text.color=#E8F0F8
button.text.color=#E8F0F8
disabled.text.color=#647487
tooltip.color=#071523
tooltip.text.color=#E8F0F8

[Window]
element=window
interior=true
top=10
bottom=10
left=10
right=10

[WindowTranslucent]
inherits=Window
element=window
interior=true

[Frame]
element=frame
interior=true
top=6
bottom=6
left=6
right=6

[Panel]
inherits=Frame
element=panel
interior=true

[Toolbar]
inherits=Frame
element=toolbar
interior=true

[Button]
element=button-normal
interior=true
top=6
bottom=6
left=8
right=8

[Button:hover]
inherits=Button
element=button-hover

[Button:pressed]
inherits=Button
element=button-pressed

[Button:focus]
inherits=Button
element=button-focus

[LineEdit]
element=lineedit
interior=true
top=6
bottom=6
left=8
right=8

[ComboBox]
inherits=LineEdit
element=combo

[Menu]
element=menu
interior=true
top=8
bottom=8
left=8
right=8

[Tooltip]
element=tooltip
interior=true
top=8
bottom=8
left=8
right=8

[Tab]
element=tab
interior=true
top=6
bottom=6
left=10
right=10

[Tab:selected]
inherits=Tab
element=tab-selected

[Progressbar]
element=progress
interior=true
top=4
bottom=4
left=4
right=4

[Slider]
element=slider
interior=true
top=4
bottom=4
left=4
right=4
